# PostgreSQL — local Homebrew default on this machine
DATABASE_URL=postgresql://matthieutohme@127.0.0.1:5432/skiplagging

# Priced offers (NDC aggregator). Shop only — Orders are never created.
# Sources page: Live (duffel_live_…) / Sandbox — offers dropped (duffel_test_…) / Needs a key.
DUFFEL_TOKEN=

# Airport FIDS (scheduled/estimated/actual). Not a fare. RapidAPI AeroDataBox.
RAPIDAPI_KEY=

# Optional OpenSky OAuth (anonymous current-states still work, tighter rate limits).
# Sources page: OAuth when both are set, otherwise Anonymous — never a green “On”.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

CACHE_TTL_SECONDS=180
# In-memory POST /search cache (Moka, 512 entries). Same origin/dest/date/adults/cabin/return.
# Live Duffel (duffel_live_…) caps this at 45s so a repeat is not a 3-minute-old shop.
# Recheck this search sends Cache-Control: no-cache (and refresh=true). Expand overwrites the key.
OFFER_TTL_SECONDS=900
# Candidate expansion. Mock/sandbox use these numbers.
# Live Duffel (duffel_live_…) floors: FAST=5, HIDDEN=12, CALLS=20 even if these are lower.
# Fast pass shops FAST_CANDIDATES ticketed Cs; expand shops the rest up to MAX_HIDDEN_CANDIDATES total.
# Honest A→B is never skipped to free budget for extra Cs. CALLS is one ledger per /search or /search/expand.
# Only candidates scoring >= CANDIDATE_MIN_SCORE are paid for (FAST_CANDIDATES hubs on a cold start).
MAX_HIDDEN_CANDIDATES=8
FAST_CANDIDATES=3
CANDIDATE_MIN_SCORE=0.35
# What one supplier search costs us, for the budget ledger (Duffel excess-search fee).
SEARCH_COST_USD=0.005
MAX_CONCURRENCY=4
MAX_PROVIDER_CALLS=12
MIN_HIDDEN_SAVING=20
DISCOVER_SKIP_DESTS=STN
MOCK_ENABLED=true
# Docker Compose interpolates DUFFEL_TOKEN / MOCK_ENABLED / RAPIDAPI_KEY / OpenSky OAuth from this directory's .env.
# Production: MOCK_ENABLED=false and a duffel_live_… token.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
