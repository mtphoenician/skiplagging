# PostgreSQL — local Homebrew default on this machine
DATABASE_URL=postgresql+asyncpg://matthieutohme@127.0.0.1:5432/skiplagging

# Priced offers (GDS). Without these, search still returns airports, OpenSky traffic, and booker links.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test

# Priced offers (NDC aggregator). Shop only — Orders are never created.
DUFFEL_TOKEN=

# Airport FIDS (scheduled/estimated/actual). Not a fare. RapidAPI AeroDataBox.
RAPIDAPI_KEY=

# Optional OpenSky OAuth (anonymous current-states still work, tighter rate limits).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

CACHE_TTL_SECONDS=180
OFFER_TTL_SECONDS=900
MAX_HIDDEN_CANDIDATES=8
MAX_CONCURRENCY=4
MAX_PROVIDER_CALLS=12
MIN_HIDDEN_SAVING=20
MOCK_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
