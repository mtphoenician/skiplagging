# PostgreSQL — local Homebrew default on this machine
DATABASE_URL=postgresql://matthieutohme@127.0.0.1:5432/skiplagging

# Priced offers (NDC aggregator). Shop only — Orders are never created.
DUFFEL_TOKEN=

# Airport FIDS (scheduled/estimated/actual). Not a fare. RapidAPI AeroDataBox.
RAPIDAPI_KEY=

# Optional OpenSky OAuth (anonymous current-states still work, tighter rate limits).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

CACHE_TTL_SECONDS=180
OFFER_TTL_SECONDS=900
# Candidate expansion: fast pass shops FAST_CANDIDATES, deep pass up to MAX_HIDDEN_CANDIDATES.
# Only candidates scoring >= CANDIDATE_MIN_SCORE are paid for (3 hubs on a cold start).
MAX_HIDDEN_CANDIDATES=8
FAST_CANDIDATES=3
CANDIDATE_MIN_SCORE=0.35
# What one supplier search costs us, for the budget ledger (Duffel excess-search fee).
SEARCH_COST_USD=0.005
MAX_CONCURRENCY=4
MAX_PROVIDER_CALLS=12
MIN_HIDDEN_SAVING=20
DISCOVER_SKIP_DESTS=STN
MOCK_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
